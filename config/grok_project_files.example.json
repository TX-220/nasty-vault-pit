{
  "_comment": "Copy to grok_project_files.json and replace the placeholder paths. Do not commit the copy. Keyword names such as Grok-Full-Fusion are reference buckets under Lilith/Materials/, not project folders. Sources that already live inside the vault are skipped.",
  "upload_subdir": "_uploads",
  "text_extensions": [".md", ".txt", ".markdown", ".json", ".yaml", ".yml", ".csv", ".tsv", ".toml", ".rst", ".log"],
  "max_file_bytes": 2000000,
  "sources": [
    {
      "path": "/path/to/downloads",
      "recursive": false
    },
    {
      "path": "/path/to/vault/notes",
      "recursive": true,
      "force_project": "Grok-Full-Fusion"
    }
  ],
  "name_rules": [
    {
      "project": "Grok-Full-Fusion",
      "name_contains": ["HANDOFF", "persona", "v10."]
    },
    {
      "project": "Trading",
      "name_contains": ["Trading", "OHLCV"]
    }
  ],
  "explicit_files": [
    {
      "path": "/path/to/a-note.md",
      "project": "Grok-Full-Fusion"
    }
  ],
  "skip_name_contains": [
    "archive/", "node_modules", ".git/", "__pycache__", ".obsidian/"
  ]
}
